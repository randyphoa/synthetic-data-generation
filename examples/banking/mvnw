#!/bin/sh
# Maven Wrapper script
# https://maven.apache.org/wrapper/

set -euf

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd -- "$(dirname -- "$0")" && pwd -P)}"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"
MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"

if [ -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
    MAVEN_DIST_URL=$(grep 'distributionUrl' "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2- | tr -d '\r')
fi
MAVEN_DIST_URL="${MAVEN_DIST_URL:-https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.6/apache-maven-3.9.6-bin.zip}"

MAVEN_HOME="$HOME/.m2/wrapper/dists/$(basename "$MAVEN_DIST_URL" .zip)"

if [ ! -d "$MAVEN_HOME" ]; then
    echo "Downloading Maven from $MAVEN_DIST_URL"
    mkdir -p "$MAVEN_HOME"
    TMPFILE=$(mktemp /tmp/maven-wrapper.XXXXXX.zip)
    if command -v curl > /dev/null 2>&1; then
        curl -fsSL -o "$TMPFILE" "$MAVEN_DIST_URL"
    elif command -v wget > /dev/null 2>&1; then
        wget -q -O "$TMPFILE" "$MAVEN_DIST_URL"
    else
        echo "Error: curl or wget is required to download Maven." >&2
        exit 1
    fi
    unzip -q -o "$TMPFILE" -d "$MAVEN_HOME"
    rm -f "$TMPFILE"
fi

MAVEN_EXEC=$(find "$MAVEN_HOME" -name mvn -type f -path "*/bin/mvn" | head -1)

if [ -z "$MAVEN_EXEC" ]; then
    echo "Error: Could not find Maven executable after download." >&2
    exit 1
fi

exec "$MAVEN_EXEC" "$@"
